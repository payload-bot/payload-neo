{
  "license": "MIT",
  "unstable": [
    "temporal"
  ],
  "preferPackageJson": true,
  "compilerOptions": {
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true
  },
  "fmt": {
    "lineWidth": 240,
    "useBraces": "always",
    "bracePosition": "sameLineUnlessHanging",
    "exclude": [
      "src/drizzle/*",
      "src/languages/*"
    ]
  },
  "lint": {
    "exclude": [
      "src/drizzle/*",
      "src/languages/*"
    ]
  }
}
